# Miscellaneous
*.class
*.log
*.pyc
*.swp
__pycache__/

# Word lock files and autosave backups (docs/entrega is edited in Word)
~$*.docx
*.wbk
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local dart-define config (real keys) - env.example.json is the checked-in template
env.json

# Release signing. The keystore and its passwords never enter the repository:
# whoever holds them can publish an update as if they were the author.
android/key.properties
*.jks
*.keystore

# Personal and academic material (course deliverables, documents carrying the
# author's or third parties' personal data). This repository is public and
# nothing of the sort is ever versioned, not even once, because history is
# forever. These files still live on disk, they are just not tracked.
docs/entrega/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
